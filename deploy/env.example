# /etc/nknu/env：实验室机器上 nknu 各服务的环境变量（install.sh 第一次执行时从本档复制，之后不会覆盖）。
# 格式：一行一个 KEY=VALUE，等号两边不要有空格，注释只能独占一行；systemd 和 /usr/local/bin/nknu 都读这个档。
# 改完后执行 sudo systemctl restart nknu-mcp；改了 NKNU_BACKUP_DIR 要重跑 sudo bash /opt/nknu/deploy/install.sh。

# 资料目录：facts.db、serve.db、warc/ 网页存档、misses.jsonl（查无资料的问题）都放这里。
NKNU_DATA_DIR=/var/lib/nknu

# 设定目录：entities.yaml（地点与别名）和 templates.yaml（答案句模板），默认就是仓库里的 config/。
NKNU_CONFIG_DIR=/opt/nknu/config

# 紧急开关：设成 1 时，抓取照跑但不写入 facts.db，nknu review、nknu add、nknu undo 也停用；平常留空。
NKNU_READONLY=

# 停用的来源（逗号分隔，例如 pe_news,sso_news）：不再抓取，下次 nknu build 起也不放进答案；平常留空。
NKNU_DISABLED_SOURCES=

# 允许的 Host（逗号分隔，不含 https:// 和埠号）：把 REPLACE-ME.example 换成对外主机名，否则外部请求一律 421。
NKNU_ALLOWED_HOSTS=127.0.0.1,localhost,REPLACE-ME.example

# 允许的浏览器 Origin（逗号分隔）：建议填 https://对外主机名；客户端回报 403 Forbidden Origin 时再加它的 Origin。
NKNU_ALLOWED_ORIGINS=

# 限流用的真实 IP：Cloudflare tunnel 填 1（默认），采用 cloudflared 传来的 CF-Connecting-IP，每个 IP 每分钟 60 次；
# Tailscale Funnel 填 0，不采用这个头（客户端能自己伪造），全部请求合用每分钟 600 次。见 deploy/tunnel/README.md。
NKNU_TRUST_CF_HEADER=1

# Discord webhook 网址（可选）：每轮抓取有写入、下架或告警时发一则摘要（含来源冲突），备份或夜间重建失败时也通知；
# 留空就只写进 log（journalctl）和 nknu alerts。
NKNU_DISCORD_WEBHOOK=

# 每天备份 facts.db 的目录（绝对路径，不能有空格）：最好在另一颗磁碟或学校 NAS，只保留最新 14 份。
NKNU_BACKUP_DIR=/var/backups/nknu
